# 复制为 .env 后按需修改（不要提交 .env 到版本库）

# ========== 大模型（LLM）配置 ==========
# 必填：OpenAI API Key（或兼容接口的 Key）
OPENAI_API_KEY=xxxxx

# 可选：自定义 API 基础 URL（代理、Azure、国内中转等）
OPENAI_BASE_URL=xxxxx

# 模型名称
LLM_MODEL=doubao-seed-1-8-251228

# 生成温度（0~2，建议 0.1~0.3 更稳定）
LLM_TEMPERATURE=0.2

# 单次请求最大 token 数（不设则用模型默认）
# LLM_MAX_TOKENS=4096

# 单次请求超时（单位：秒，填 120 表示 120 秒）
LLM_REQUEST_TIMEOUT=300

# ========== 视觉模型（Vision LLM）配置 ==========
# 用于图片识别、带图分析等多模态任务，未配置时自动回退到上方文本模型配置
# 注意：.env 不支持行内注释，注释必须独占一行

# 视觉模型 API Key（不设则使用 OPENAI_API_KEY）
VISION_API_KEY=zzzzz

# 视觉模型 API 基础 URL（不设则使用 OPENAI_BASE_URL）
VISION_BASE_URL=xxx

# 视觉模型名称（不设则使用 LLM_MODEL）
VISION_MODEL=doubao-seed-1-8-251228

# 视觉模型温度（不设则使用 LLM_TEMPERATURE）
VISION_TEMPERATURE=0.2

# 视觉模型最大 token 数（不设则使用 LLM_MAX_TOKENS）
# VISION_MAX_TOKENS=4096

# 视觉模型超时秒数（不设则使用 LLM_REQUEST_TIMEOUT）
VISION_REQUEST_TIMEOUT=300

# ========== TTS ==========
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ========== 自愈、时长与动画风格 ==========
HTML_SELF_HEAL_MAX_ATTEMPTS=3
DEFAULT_WAIT_SECONDS=2.0

# 动画风格（可选）：注入到脚本生成 prompt，要求大模型按此风格生成。只保留一行生效，其余注释掉。
# 儿童插画风（圆润、柔和色彩、可爱）：
ANIMATION_STYLE=儿童插画风：圆润线条、柔和配色（如浅粉、天蓝、薄荷绿）、可爱简笔画感；动画以淡入和轻柔滑入为主，避免复杂特效
# 手绘简笔风（线条感、像手画草图）：
# ANIMATION_STYLE=手绘简笔风：线条略粗、有手绘抖动感，像铅笔或马克笔草图；配色简洁（黑线+少量色块或留白）；动画以淡入、简单位移为主，保持简笔画气质
# 教科书极简风：
# ANIMATION_STYLE=教科书风格、极简、白底；动画以淡入和滑入为主
# 不设则留空：ANIMATION_STYLE=

# 脚本生成阶段超时（单位：秒，填 300 表示 5 分钟；504 需在 ops-ai-gateway 或前置 Nginx 调大 proxy_read_timeout）
LLM_SCRIPT_TIMEOUT=300

# ========== Tutor 视频流水线（仅当界面/API 选择 output_format=video 时生效）==========
# 需先安装 Manim：pip install manim 或取消 requirements.txt 中 manim 注释

# Manim 可执行命令（或绝对路径，如 /usr/local/bin/manim）
MANIM_COMMAND=manim

# 要渲染的场景类名
MANIM_SCENE_CLASS=MathScene

# 渲染质量：ql=480p, qm=720p30, qh=1080p60, qk=4K
MANIM_QUALITY=qh

# 渲染失败时 LLM 自愈最大重试次数
MANIM_SELF_HEAL_MAX_ATTEMPTS=3